@model MVC_Homework.Models.ExerciseRecord

<h2>新增健身紀錄</h2>

<form method="post">
    <p>運動名稱：</p>
    <input type="text" name="ExerciseName" />

    <p>運動日期：</p>
    <input type="date" name="ExerciseDate" />

    <p>運動時間：</p>
    <input type="number" name="Duration" />

    <p>消耗熱量：</p>
    <input type="number" name="Calories" />

    <p>備註：</p>
    <input type="text" name="Note" />

    <br /><br />

    <button type="submit">新增</button>
</form>

<br />

<a href="/ExerciseRecords">
    <button type="button">回健身紀錄列表</button>
</a>