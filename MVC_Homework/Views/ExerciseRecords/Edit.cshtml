@model MVC_Homework.Models.ExerciseRecord

<h2>編輯健身紀錄</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    <p>運動名稱：</p>
    <input type="text" name="ExerciseName" value="@Model.ExerciseName" />

    <p>運動日期：</p>
    <input type="date" name="ExerciseDate" value="@Model.ExerciseDate?.ToString("yyyy-MM-dd")" />

    <p>運動時間：</p>
    <input type="number" name="Duration" value="@Model.Duration" />

    <p>消耗熱量：</p>
    <input type="number" name="Calories" value="@Model.Calories" />

    <p>備註：</p>
    <input type="text" name="Note" value="@Model.Note" />

    <br /><br />

    <button type="submit">儲存修改</button>
</form>

<br />

<a href="/ExerciseRecords">
    <button type="button">回健身紀錄列表</button>
</a>
