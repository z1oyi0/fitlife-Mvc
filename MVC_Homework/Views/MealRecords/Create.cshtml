@model MVC_Homework.Models.MealRecord
<div class="container mt-5"><div class="card shadow-sm p-4">
    <h2 class="mb-4">新增飲食紀錄</h2>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="MealType">餐別</label><select asp-for="MealType" class="form-control"><option value="">請選擇餐別</option><option>早餐</option><option>午餐</option><option>晚餐</option><option>點心</option><option>宵夜</option></select></div>
        <div class="mb-3"><label asp-for="MealName">食物名稱</label><input asp-for="MealName" class="form-control" /><span asp-validation-for="MealName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MealDate">用餐日期</label><input asp-for="MealDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Calories">熱量</label><input asp-for="Calories" type="number" min="0" step="1" class="form-control" /><span asp-validation-for="Calories" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Note">備註</label><input asp-for="Note" class="form-control" /></div>
        <button type="submit" class="btn btn-success">送出</button><a asp-action="Index" class="btn btn-secondary">回飲食紀錄</a>
    </form>
</div></div>
